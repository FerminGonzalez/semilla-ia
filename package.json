{
  "name": "semilla-ia-nodo",
  "version": "1.0.0",
  "description": "Semilla-IA — nodo neuro-educativo autónomo: inferencia local, sin internet, con orquestador simbólico y copiloto docente",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "report": "python scripts/make-report.py",
    "bitnet": "python tools/bitnet_server.py",
    "nodo": "node tools/run_nodo.mjs"
  }
}

